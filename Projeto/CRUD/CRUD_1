                            print('Opção inválida, Digite o número relativo a uma das opções acima sem espaços.')
                        else:
                            email, numero, endereco = '', '', ''
                            match escolha_tipo_informacao:
                                case '1':
                                    email = input('Digite o Email: ')
                                    nome = novo_nome
                                    print('Contato Adicionado!')
                                case '2':
                                    numero = input('Digite o Número: ')
                                    nome = novo_nome
                                    print('Contato Adicionado!')
                                case '3':
                                    endereco = input('Digite o endereço: ')
                                    nome = novo_nome
                                    print('Contato Adicionado!')
                else:
                    nome = input('Digite o nome do novo contato: ')
                    print('O que quer adicionar?\n[1] EMAIL\n[2] NÚMERO\n[3] ENDEREÇO')
                    escolha_tipo_informacao = input('--> ')
                    if escolha_tipo_informacao != '1' and escolha_tipo_informacao != '2' and escolha_tipo_informacao != '3':
                        nome = ''
                        print('Opção inválida, Digite o número relativo a uma das opções acima sem espaços.')
                    else:
                        match escolha_tipo_informacao:
                            case '1':
                                email = input('Digite o Email: ')
                            case '2':
                                numero = input('Digite o Número: ')
                            case '3':
                                endereco = input('Digite o endereço: ')  
            case '3':
                if nome != '':
                    nome, email, numero, endereco = '', '', '', ''
                    print('Contato Removido!')     
                else:
                    print('Sem contatos, não há nada para ser removido.')
            case '4':
                if nome != '':
                    print('Pelo que quer substituir a informação atual?\n[1] EMAIL\n[2] NÚMERO\n[3] ENDEREÇO')
                    escolha_tipo_substituicao = input('--> ')
